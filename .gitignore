# Datos crudos HAM10000 (no se suben a git)
data/raw/*
!data/raw/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Build del libro (MyST)
_build/

# Entorno virtual (uv)
.venv/

# Datos procesados (caché del EDA, etc.)
data/processed/

.ruff_cache/

# MLflow local y tablas en cache del benchmark (se regeneran desde outputs/runs)
outputs/mlflow/
outputs/benchmark_e2/

# Pesos de las corridas (VGG-16: ~540 MB por corrida; GitHub rechaza archivos > 100 MB)
outputs/**/*.weights.h5
